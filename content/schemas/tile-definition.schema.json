{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carcassonne.local/schemas/tile-definition.schema.json",
  "title": "TileDefinitionCatalog",
  "description": "地块定义目录。语义见 docs/TILE_TOPOLOGY_SPEC.md；字段要求见 docs/TILE_AND_EXPANSION_CATALOG.md §3。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalogId",
    "rulesetVersion",
    "expansionId",
    "status",
    "designs"
  ],
  "properties": {
    "catalogId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "rulesetVersion": {
      "type": "string",
      "description": "规则版本 ID，如 base-current"
    },
    "expansionId": {
      "type": "string",
      "description": "所属基础包或扩展，如 base"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "frozen"]
    },
    "sourceBaseline": {
      "type": "object",
      "additionalProperties": true,
      "description": "官方来源基线，自由形式，录入时填写"
    },
    "designs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tileDesign" }
    }
  },
  "$defs": {
    "direction": {
      "type": "string",
      "enum": ["N", "E", "S", "W"]
    },
    "rotation": {
      "type": "string",
      "enum": ["North", "East", "South", "West"]
    },
    "zone": {
      "type": "string",
      "enum": ["left", "center", "right"]
    },
    "featureType": {
      "type": "string",
      "enum": ["field", "road", "city", "garden", "river"]
    },
    "edgePort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge", "zones"],
      "properties": {
        "edge": { "$ref": "#/$defs/direction" },
        "zones": {
          "type": "array",
          "items": { "$ref": "#/$defs/zone" },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localSegmentId", "featureType", "ports"],
      "properties": {
        "localSegmentId": {
          "type": "string",
          "pattern": "^seg-[a-z0-9-]+$"
        },
        "featureType": { "$ref": "#/$defs/featureType" },
        "ports": {
          "type": "array",
          "items": { "$ref": "#/$defs/edgePort" },
          "minItems": 1
        },
        "endsAtCenter": {
          "type": "boolean",
          "description": "道路等段的端口是否终止于中心特征（如修道院）。缺省为 false。"
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["pennant"]
          },
          "uniqueItems": true
        }
      }
    },
    "centerFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["centerFeatureId", "kind"],
      "properties": {
        "centerFeatureId": {
          "type": "string",
          "pattern": "^center-[a-z0-9-]+$"
        },
        "kind": {
          "type": "string",
          "enum": ["monastery", "garden"]
        }
      }
    },
    "meepleZone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zoneId", "targetRef", "allowedPieces"],
      "properties": {
        "zoneId": {
          "type": "string",
          "pattern": "^zone-[a-z0-9-]+$"
        },
        "targetRef": {
          "type": "string",
          "description": "引用的 localSegmentId 或 centerFeatureId"
        },
        "allowedPieces": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["meeple", "abbot"]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "tileDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tileDefinitionId",
        "copiesInPool",
        "startTileCopies",
        "footprint",
        "allowedRotations",
        "distinctRotations",
        "segments",
        "meepleZones",
        "sourceReference",
        "verificationStatus"
      ],
      "properties": {
        "tileDefinitionId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.[a-z0-9-]+$"
        },
        "copiesInPool": {
          "type": "integer",
          "minimum": 0
        },
        "startTileCopies": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "footprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["singleCell"]
            }
          }
        },
        "allowedRotations": {
          "type": "array",
          "items": { "$ref": "#/$defs/rotation" },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        },
        "distinctRotations": {
          "type": "integer",
          "enum": [1, 2, 4]
        },
        "segments": {
          "type": "array",
          "items": { "$ref": "#/$defs/segment" },
          "minItems": 1
        },
        "centerFeatures": {
          "type": "array",
          "items": { "$ref": "#/$defs/centerFeature" }
        },
        "meepleZones": {
          "type": "array",
          "items": { "$ref": "#/$defs/meepleZone" }
        },
        "placementTags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["start-tile", "river-source", "river-lake", "river-curve"]
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string",
          "description": "录入备注：朝向约定、变体说明与不确定点标注（可选）"
        },
        "visualAssetId": {
          "type": ["string", "null"]
        },
        "sourceReference": {
          "type": "string",
          "minLength": 1
        },
        "verificationStatus": {
          "type": "string",
          "enum": ["待录入", "已录入", "已复核", "已测试"]
        }
      }
    }
  }
}
